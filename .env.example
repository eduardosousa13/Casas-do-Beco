# Destination of messages submitted through the contact form.
CONTACT_TO_EMAIL=casasdobecoladoeiro@gmail.com

# SMTP account used by the server to send those messages. For Gmail, create an
# app password in the Google Account; never use the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=casasdobecoladoeiro@gmail.com
SMTP_PASSWORD=

# Optional: defaults to SMTP_USER. The address must be allowed by the SMTP provider.
SMTP_FROM_EMAIL=

# PMS database. `docker compose up -d db` starts the local development database.
DATABASE_URL=postgres://casas_dev:change_this_for_local_dev@localhost:5432/casas_do_beco

# Keep public online booking off until rooms, rates, policies, Stripe test mode,
# webhook delivery and operational procedures have been verified.
BOOKINGS_ENABLED=false
PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Only set this for a deliberately approved live launch after full testing.
STRIPE_LIVE_ALLOWED=false
PMS_ADMIN_ACTOR=

# Segredo de autenticação: gerar com openssl rand -base64 48. Nunca publicar.
BETTER_AUTH_SECRET=

# Enable only behind Railway HTTP ingress, which overwrites X-Real-IP.
# Leave false for direct/local connections or an unverified proxy.
TRUST_RAILWAY_PROXY=false
