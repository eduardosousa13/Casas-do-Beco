{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "vite build && node scripts/build.mjs",
    "preview": "node dist/server/index.mjs",
    "start:local": "node --env-file=.env.local dist/server/index.mjs",
    "test:contact": "node --import tsx --test tests/contact.test.ts",
    "test:pms": "node --import tsx --test tests/pms.test.ts tests/pms-regressions.test.ts tests/checkout.test.ts",
    "test:pms:postgres": "node --env-file=.env.local --import tsx --test tests/pms-postgres.test.ts",
    "pms:migrate": "node --env-file=.env.local --import tsx pms/migrate.ts",
    "pms:admin": "node --env-file=.env.local --import tsx pms/admin.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "pms:owner": "node --env-file=.env.local --import tsx pms/bootstrap-owner.ts",
    "pms:mail": "node --env-file=.env.local --import tsx pms/mail-worker.ts",
    "test:admin": "node --import tsx --test tests/admin-configuration.test.ts tests/admin-activity.test.ts tests/auth-email.test.ts",
    "test:admin:postgres": "node --env-file=.env.local --import tsx --test tests/admin-auth-postgres.test.ts",
    "pms:worker": "node --env-file=.env.local --import tsx pms/worker-cli.ts",
    "test:owner": "node --import tsx --test tests/owner.test.ts",
    "test:owner:postgres": "node --env-file=.env.local --import tsx --test tests/owner-postgres.test.ts",
    "start": "node dist/server/index.mjs",
    "test:server": "node --import tsx --test tests/server.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-auth": "1.7.7",
    "cookie": "2.0.1",
    "dotenv": "^17.2.3",
    "framer-motion": "12.43.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "10.0.12",
    "pg": "8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "stripe": "22.6.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
